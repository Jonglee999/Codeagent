# === LLM 配置 ===
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT=60

# === 嵌入模型配置 ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === Agent 行为配置 ===
MAX_RETRIES=3
CONTEXT_BUDGET_TOKENS=8000
AUTO_MODE=false

# === Docker 沙箱配置（Phase 1b）===
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=60

# === 日志配置 ===
LOG_LEVEL=INFO

# LLM provider (required only for real agent runs)
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT=300

# Three-tier routing. L1/L2 use Flash; L3 handles complex/high-risk work with Pro.
MODEL_ROUTING_ENABLED=true
MODEL_ROUTING_MODE=on
MODEL_L1_NAME=deepseek/deepseek-v4-flash
MODEL_L1_API_BASE=
MODEL_L1_API_KEY=
MODEL_L1_CONTEXT_WINDOW=128000
MODEL_L2_NAME=deepseek/deepseek-v4-flash
MODEL_L2_API_BASE=
MODEL_L2_API_KEY=
MODEL_L2_CONTEXT_WINDOW=128000
MODEL_L3_NAME=deepseek/deepseek-v4-pro
MODEL_L3_API_BASE=
MODEL_L3_API_KEY=
MODEL_L3_CONTEXT_WINDOW=128000

# A2A 1.0 interoperability. Server and outbound delegation are separate kill switches.
A2A_SERVER_ENABLED=false
A2A_CLIENT_ENABLED=false
A2A_BASE_URL=http://127.0.0.1:8000
A2A_DELEGATE_URL=
A2A_PROJECT_ROOT=.
A2A_API_KEYS=
A2A_REMOTE_API_KEY=
A2A_ALLOWLIST=127.0.0.1,localhost
A2A_TIMEOUT_SECONDS=900
A2A_MAX_MESSAGE_BYTES=1048576
A2A_MAX_ARTIFACT_BYTES=4194304
A2A_MAX_DELEGATION_DEPTH=1
A2A_TASK_DB_PATH=.codeagent/state/a2a_tasks.db

# Model resilience. Fallback stays disabled until LLM_FALLBACK_MODEL is set.
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_RETRY_JITTER_SECONDS=0.2
LLM_RETRY_AFTER_CAP_SECONDS=30
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_TIMEOUT=120

# Local development
USE_INLINE_RUNNER=true
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=INFO

# Agent budgets
MAX_RETRIES=3
MAX_LLM_CALLS_PER_TASK=20
MAX_TOKENS_PER_TASK=500000
MAX_COMPLETION_TOKENS_PER_CALL=32768
BENCHMARK_DISCOVERY_WARNING_RATIO=0.60
BENCHMARK_INVALID_TOOL_WARNING_RATIO=0.20
BENCHMARK_TOKEN_WARNING_RATIO=0.90
CONTEXT_MODE=auto
CONTEXT_TARGET_INPUT_TOKENS=80000
CONTEXT_MIN_INPUT_TOKENS=16000
CONTEXT_MAX_INPUT_TOKENS=80000
CONTEXT_SAFETY_MARGIN_TOKENS=8000
CONTEXT_TOOL_OVERHEAD_TOKENS=8000
# Legacy alias: CONTEXT_BUDGET_TOKENS
CONTEXT_AST_MODE=auto
CONTEXT_SEMANTIC_MODE=auto
CONTEXT_INDEX_BACKGROUND=true
CONTEXT_AUTO_FILE_LIMIT=300
# Pre-reasoning semantic injection stays deliberately small; broader discovery
# is handled on demand by search_code(search_type=explore).
CONTEXT_PREINJECT_MAX_FILES=5
LLM_CONTEXT_WINDOW=128000

# Tool execution. false executes safety-checked commands in the selected local workspace.
# true enables Docker-backed command isolation when the task environment supports it.
SANDBOX_ENABLED=true
SANDBOX_IMAGE=codeagent-sandbox:latest
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY_MB=1024

# Context and memory
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMORY_TOKEN_BUDGET=1200
MEMORY_SESSION_TTL_DAYS=7
MEMORY_INDEX_MAX_LINES=300
MEMORY_USE_VECTOR=false
MEMORY_ENABLED=true
SKILLS_ENABLED=true
MCP_ENABLED=true
EVOLUTION_ENABLED=true

# Persistent LangGraph checkpoints
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_PATH=.codeagent/state/checkpoints.db
CHECKPOINT_TTL_DAYS=30

# Optional API authentication (comma-separated keys). Leave empty for local development.
API_KEYS=
RATE_LIMIT_RPM=100

# Distributed worker mode only
CELERY_TASK_TIMEOUT=900

# === LLM 配置 ===
# API Key（必填），支持 DeepSeek / OpenAI / Anthropic 等
LLM_API_KEY=your_api_key_here
# API Base URL，默认使用 DeepSeek
LLM_API_BASE=https://api.deepseek.com/v1
# 模型名称，格式: provider/model，如 deepseek/deepseek-v4-flash、openai/gpt-4o
LLM_MODEL=deepseek/deepseek-v4-flash
# LLM 请求超时秒数
LLM_TIMEOUT=60

# === 嵌入模型配置 ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === Agent 行为配置 ===
MAX_RETRIES=3
CONTEXT_BUDGET_TOKENS=8000
AUTO_MODE=false

# === LLM 成本控制 ===
# 单次任务最大 LLM 调用次数（防止无限循环）
MAX_LLM_CALLS_PER_TASK=50
# 单次任务最大 token 消耗估算
MAX_TOKENS_PER_TASK=100000

# === Docker 沙箱（需安装 Docker Desktop）===
# 启用后代码执行在 Docker 容器中隔离运行
SANDBOX_ENABLED=false
# 容器命令执行超时秒数
SANDBOX_TIMEOUT=60
# 容器内存限制（MB）
SANDBOX_MEMORY_MB=512

# === Checkpoint 持久化（需安装 langgraph-checkpoint-sqlite）===
# SQLite checkpoint 文件路径，默认 ~/.codeagent/checkpoints.db
CHECKPOINT_DB_PATH=~/.codeagent/checkpoints.db

# === 记忆系统配置 ===
# 全局记忆存储根目录
MEMORY_GLOBAL_ROOT=~/.codeagent/memory
# 记忆注入 System Prompt 的 token 预算
MEMORY_TOKEN_BUDGET=800
# Session 类型记忆过期天数
MEMORY_SESSION_TTL_DAYS=7
# MEMORY.md 索引最大行数
MEMORY_INDEX_MAX_LINES=200

# === 日志配置 ===
LOG_LEVEL=INFO
